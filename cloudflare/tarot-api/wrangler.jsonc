{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorasukt-API",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.sorasukt.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "ALLOWED_ORIGINS": "https://sorasukt.com,https://www.sorasukt.com"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}
